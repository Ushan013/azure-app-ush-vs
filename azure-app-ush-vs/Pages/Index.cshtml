@page
@model IndexModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>For My Princess ❤️</title>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #fff0f5 0%, #ffc0cb 100%);
            font-family: 'Poppins', sans-serif;
            color: #4a148c;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            overflow: hidden;
        }

        .heart-container {
            width: 100%;
            max-width: 380px;
            position: relative;
            z-index: 2;
        }

        .main-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 25px 20px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(233, 30, 99, 0.2);
        }

        h1.romantic-title {
            font-family: 'Great Vibes', cursive;
            font-size: 3rem;
            color: #e91e63;
            margin-bottom: 5px;
        }

        .girl-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: #d81b60;
            margin-bottom: 20px;
        }

        .photo-wrapper {
            position: relative;
            width: 160px;
            height: 160px;
            margin: 0 auto 20px;
            border-radius: 50%;
            padding: 6px;
            background: linear-gradient(45deg, #e91e63, #ffd700);
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

        .photo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid white;
        }

        .love-message {
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 20px;
            padding: 12px;
            background: rgba(255, 240, 245, 0.8);
            border-radius: 12px;
        }

        .btn-love {
            background: linear-gradient(45deg, #e91e63, #ff4081);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(233, 30, 99, 0.4);
            margin-bottom: 15px;
            width: 100%;
            transition: 0.3s ease;
        }

        .btn-love:active { transform: scale(0.98); }

        .hidden-poem {
            display: none;
            color: #880e4f;
            font-style: italic;
            font-weight: 500;
            margin-top: 15px;
            animation: fadeIn 0.5s ease;
        }

        .heart {
            position: fixed;
            color: #ff4081;
            font-size: 18px;
            opacity: 0.7;
            animation: float 4s linear infinite;
            z-index: 1;
        }

        @@keyframes float { 0% { transform: translateY(100vh); } 100% { transform: translateY(-10vh); } }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>
    <div class="heart" style="left: 10%; animation-duration: 5s;">❤️</div>
    <div class="heart" style="left: 30%; animation-duration: 4s;">💖</div>
    <div class="heart" style="left: 70%; animation-duration: 6s;">💕</div>
    <div class="heart" style="left: 85%; animation-duration: 4.5s;">💘</div>

    <!-- Romantic Background Music Audio Element -->
    <!-- Oyata kamathi song ekaka direct link ekak (mp3) meke source ekata danna puluwan -->
    <audio id="loveSong" loop>
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mp3">
        Your browser does not support the audio element.
    </audio>

    <div class="heart-container">
        <div class="main-card">
            <h1 class="romantic-title">Mage Adare...</h1>
            <p class="girl-name">Sudu Dooni ❤️</p>
            
            <div class="photo-wrapper">
                <div class="photo-frame">
                    <img src="/gf_photo.jpg" alt="My Love" />
                </div>
            </div>
            
            <p class="love-message">
                Oya mage jeewithata aawata passe hama dema lassana wuna. 
                Mage hemama sathutak pitipassenma inne oya... 
                Oya nathuwama ba mage raththarane!
            </p>
            
            <button id="musicBtn" class="btn-love" onclick="toggleLoveSurprise()">🎵 Touch For Special Song & Message</button>
            
            <div id="hiddenPoem" class="hidden-poem">
                "Samsara puruddata wage mata oyawa hamuwune... Jeewithe thiyenathakuru mama oyata me waguwatama adare karanawa!" 💖🥰
            </div>
            
            <div style="margin-top: 20px; font-style: italic; color: #d81b60; font-size: 0.9rem;">
                - Oyae Adare, [Your Name]
            </div>
        </div>
    </div>

    <script>
        function toggleLoveSurprise() {
            var poem = document.getElementById("hiddenPoem");
            var song = document.getElementById("loveSong");
            var btn = document.getElementById("musicBtn");

            if (poem.style.display === "block") {
                poem.style.display = "none";
                song.pause();
                btn.innerHTML = "🎵 Touch For Special Song & Message";
            } else {
                poem.style.display = "block";
                song.play().catch(error => {
                    console.log("Audio play blocked by browser policy until user interaction.");
                });
                btn.innerHTML = "⏸️ Pause Song & Hide";
            }
        }
    </script>
</body>
</html>